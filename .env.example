# Required in production. Set your own hosting URL (domain root, no /admin).
# For local development this may be omitted; the current address is used.
APP_URL=
# Optional LAN development hostnames, comma-separated (no scheme or port).
DEV_ALLOWED_ORIGINS=

# Without these values, local development uses an in-memory demo. Production never falls back to demo.
SUPABASE_URL=
# Paste the server Secret key (sb_secret_...). Legacy service_role is also supported.
SUPABASE_SERVICE_ROLE_KEY=
# Generate: openssl rand -hex 32. Keep this stable; changing it makes existing secrets unreadable.
VAULT_ENCRYPTION_KEY=
# Optional: explicit local demo. Never enable this for real company data.
X_KEY_DEMO=false
