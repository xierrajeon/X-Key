# Without these values, local development uses an in-memory demo. Production never falls back to demo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Generate: openssl rand -hex 32. Keep this stable; changing it makes existing secrets unreadable.
VAULT_ENCRYPTION_KEY=
# Optional: explicit local demo. Never enable this for real company data.
X_KEY_DEMO=false
